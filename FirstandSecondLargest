public class Program
{
	public static void Main()
	{
	  int[] arr = {10, 80, 5, 140, 60};
		int leftindex =0;
		int nextindex =0;
		for(int i=0 ;i<5;i++)
		{
			if(leftindex < arr[i])
			{
				leftindex = arr[i];
			}
		}
		for(int j=0;j<5;j++)
		{
			if(arr[j] != leftindex && nextindex <arr[j])
			{
				nextindex = arr[j];
			}
		}
		Console.WriteLine(leftindex);
		Console.WriteLine(nextindex);
	}
}
